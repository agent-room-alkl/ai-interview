# Auth (NextAuth v5)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# AI — leave AI_GATEWAY_API_KEY empty to use OpenAI directly with AI_MODEL=gpt-4o-mini
AI_GATEWAY_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Shared Postgres (same DB as agent-room). App tables use schema `ai_interview`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require"

# ElevenLabs (optional; TTS currently uses OpenAI)
ELEVENLABS_API_KEY=""
ELEVELABS_KEY=""
