# SQLite (local/dev). For production, switch Prisma datasource to Postgres (Neon)
# and set DATABASE_URL to your Neon connection string.
DATABASE_URL="file:./dev.db"

# Auth (NextAuth v5)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# AI — prefer Vercel AI Gateway; OpenAI key works for local TTS / fallback
AI_GATEWAY_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="openai/gpt-4o-mini"
