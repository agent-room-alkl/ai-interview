// Prisma schema for AI Interview — uses dedicated schema on shared Postgres
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["ai_interview"]
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String?
  createdAt    DateTime    @default(now())
  interviews   Interview[]

  @@schema("ai_interview")
}

model Interview {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateName String
  resumeText    String
  resumeFileUrl String?
  targetRole    String?
  mode          String // "practice" | "interview"
  status        String   @default("draft") // draft | ready | in_progress | completed
  createdAt     DateTime @default(now())
  turns         Turn[]

  @@schema("ai_interview")
}

model Turn {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  speaker     String // interviewer | trainer | user
  text        String
  audioUrl    String?
  createdAt   DateTime  @default(now())

  @@schema("ai_interview")
}
