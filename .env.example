# Public site URL for canonical links, Open Graph, sitemap, and robots.
# Production: https://ainterv.com
NEXT_PUBLIC_SITE_URL=https://ainterv.com

# Clerk (set in Vercel project env — do NOT wrap values in quotes)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# AI — leave AI_GATEWAY_API_KEY empty to use OpenAI directly with AI_MODEL=gpt-4o-mini
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Voice STT/TTS call OpenAI directly and require OPENAI_API_KEY even when chat
# uses AI_GATEWAY_API_KEY.
# Speech-to-text model for voice answers (OpenAI). whisper-1 is a fallback.
STT_MODEL=gpt-4o-transcribe

# Shared Postgres (same DB as agent-room). App tables use schema `ai_interview`.
# Supabase transaction pooler (:6543) needs pgbouncer=true to avoid prepared-statement errors.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true

# ElevenLabs (optional; TTS currently uses OpenAI)
ELEVENLABS_API_KEY=
ELEVELABS_KEY=
