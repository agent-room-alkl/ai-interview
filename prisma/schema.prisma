// Prisma schema for AI Interview — uses dedicated schema on shared Postgres
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["ai_interview"]
}

model User {
  id               String      @id // Clerk userId (user_…)
  email            String      @unique
  passwordHash     String // unused under Clerk — written as "" for NOT NULL compat
  name             String?
  resumeContext    String?
  /// Paid practice access expires at this time (UTC). Null = never purchased / expired.
  accessUntil      DateTime?
  /// One free 10-minute trial session; set true when the trial interview is created.
  trialUsed        Boolean     @default(false)
  stripeCustomerId String?
  createdAt        DateTime    @default(now())
  interviews       Interview[]
  purchases        Purchase[]

  @@schema("ai_interview")
}

/// One-time practice access pack purchase (day / week / month).
model Purchase {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack                  String // day | week | month
  days                  Int
  amountCents           Int
  currency              String    @default("usd")
  status                String    @default("pending") // pending | paid | failed | refund_requested | refunded
  stripeCheckoutSession String?   @unique
  stripePaymentIntent   String?
  stripeRefundId        String?
  refundRequestedAt     DateTime?
  refundedAt            DateTime?
  createdAt             DateTime  @default(now())
  paidAt                DateTime?

  @@index([userId])
  @@schema("ai_interview")
}

model Interview {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateName String
  resumeText    String
  resumeFileUrl String?
  targetRole    String? // primary role (first of targetRoles) — kept for display/back-compat
  targetRoles   String[] @default([]) // one or more roles the candidate is interviewing for
  language      String   @default("en") // BCP-47 primary subtag the interview is conducted in (detected from résumé, user-overridable)
  mode          String // "practice" | "interview"
  durationMinutes Int    @default(10) // formal interview duration; practice has no hard deadline
  status        String   @default("draft") // draft | ready | in_progress | completed
  startedAt     DateTime?
  deadlineAt    DateTime?
  pausedAt      DateTime?
  pausedRemainingSeconds Int?
  createdAt     DateTime @default(now())
  turns         Turn[]
  reportCache   InterviewReportCache?

  @@schema("ai_interview")
}

model InterviewReportCache {
  id          String    @id @default(cuid())
  interviewId String    @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  json        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@schema("ai_interview")
}

model Turn {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  speaker     String // interviewer | trainer | user
  text        String
  audioUrl    String?
  createdAt   DateTime  @default(now())

  @@schema("ai_interview")
}
